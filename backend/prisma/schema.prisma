generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One table for everything the party knows about.
///
/// `type` is a plain string ('player' | 'npc' | 'faction' | 'monster' | 'item' |
/// 'recipe', and whatever you add later) so a new kind of entry is a new form
/// template in the frontend, not a migration.
///
/// Items here are *definitions* — the repository in the Codex. Who is carrying
/// how many of one is a Holding.
///
/// `search` is a generated tsvector column. Prisma cannot express generated
/// columns, so it lives in the migration SQL and is declared Unsupported here.
/// Full-text queries go through $queryRaw in src/routes/entities.ts.
model Entity {
  id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type      String
  name      String
  summary   String?
  bodyMd    String?                  @map("body_md")
  data      Json                     @default("{}")
  imageKey  String?                  @map("image_key")
  tags      String[]                 @default([])
  knowledge String                   @default("unknown")
  search    Unsupported("tsvector")?
  createdAt DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Stacks of this item that somebody holds. Empty for non-item entities.
  heldAs Holding[] @relation("HoldingItem")
  /// Stacks this player is carrying. Empty for non-player entities.
  holds  Holding[] @relation("HoldingOwner")

  /// Notes this player wrote. Empty for non-player entities.
  notesWritten Note[] @relation("NoteAuthor")
  /// Notes other people pinned to this entry.
  notesAbout   Note[] @relation("NoteSubject")

  /// The D&D Beyond mirror, for players who have linked a character.
  ddb DdbSnapshot?

  @@index([type, knowledge])
  @@map("entities")
}

/// A stack of one item, held by a player or by nobody.
///
/// Splitting this from Entity is what lets the Codex keep a single canonical
/// entry per item while the same item sits in the stash and in two packs at
/// once — and lets "who has this?" be a question you can ask.
model Holding {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  /// The player carrying it. Null means the party stash.
  ownerId   String?  @map("owner_id") @db.Uuid
  quantity  Int      @default(1)
  /// Per-stack flavour: "attuned since session 10".
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  item  Entity  @relation("HoldingItem", fields: [itemId], references: [id], onDelete: Cascade)
  owner Entity? @relation("HoldingOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([itemId])
  @@map("holdings")
}

/// Something a player wrote, in one of three places.
///
/// `placement` says where it lives; `visibility` says who may read it. They are
/// independent: a vault note can be shared, and an entry note can be private.
///
/// Two CHECK constraints live in the migration, because Prisma cannot express
/// them: placement='entry' exactly when subjectId is set, and a party-board note
/// is always shared.
model Note {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The player who wrote it. Taken from the request, never from the body.
  authorId   String   @map("author_id") @db.Uuid
  /// The codex entry it is pinned to. Null for vault and party notes.
  subjectId  String?  @map("subject_id") @db.Uuid
  /// 'entry' | 'vault' | 'party'
  placement  String
  /// 'private' | 'shared'
  visibility String   @default("shared")
  title      String?
  bodyMd     String   @map("body_md")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  author  Entity  @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject Entity? @relation("NoteSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([authorId])
  @@index([placement, visibility])
  @@map("notes")
}

/// A character as D&D Beyond last reported it.
///
/// Deliberately walled off from Holding. A sync replaces this row whole — no
/// diffing, no merging — so the two inventories cannot drift into disagreeing.
/// One row per character, which the unique playerId enforces.
///
/// `items`, `classes` and `currencies` are JSON because nothing queries inside
/// them: they are a read-only mirror, rendered together and replaced together.
model DdbSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  playerId       String   @unique @map("player_id") @db.Uuid
  ddbCharacterId String   @map("ddb_character_id")
  /// Stored to compare against the entity's name. Never written back to it —
  /// a rename there would break every [[wiki-link]] pointing at the character.
  name           String
  race           String?
  /// [{ name, level, subclass }]
  classes        Json     @default("[]")
  avatarUrl      String?  @map("avatar_url")
  /// { cp, sp, ep, gp, pp }
  currencies     Json     @default("{}")
  items          Json     @default("[]")
  syncedAt       DateTime @map("synced_at") @db.Timestamptz(6)

  player Entity @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("ddb_snapshots")
}

/// The campaign's shared coin and items, as D&D Beyond last reported them.
///
/// No relation to Entity — the party is not one. Same rule as DdbSnapshot: a
/// sync replaces this row whole, and nothing the app owns is ever merged into
/// it. The unique campaignId is what makes a sync an upsert.
model DdbPartySnapshot {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId   String   @unique @map("campaign_id")
  campaignName String?  @map("campaign_name")
  /// { cp, sp, ep, gp, pp } — the shared purse, separate from anyone's pocket.
  currencies   Json     @default("{}")
  items        Json     @default("[]")
  syncedAt     DateTime @map("synced_at") @db.Timestamptz(6)

  @@map("ddb_party_snapshots")
}
