# Copy to .env and adjust. Docker Compose defaults match these values.

DATABASE_URL=postgresql://codex:codex@localhost:5432/codex

PORT=3001

# Passphrase that unlocks DM mode in the UI. Change this.
DM_KEY=change-me

# — Image storage —
# MinIO locally; swap for real S3 / R2 / B2 credentials when hosting.
S3_BUCKET=assets
S3_ACCESS_KEY=codexminio
S3_SECRET_KEY=codexminio123
S3_REGION=us-east-1

# The host the BROWSER uses to reach MinIO, which is not necessarily this
# machine's view of it. `auto` picks this machine's LAN address so phones on the
# same wifi can load images — `localhost` would point each phone at itself.
# Pin it to an IP or hostname if auto-detection picks the wrong interface.
S3_PUBLIC_HOST=auto
S3_PORT=9000

# Only needed to point at something other than MinIO-on-this-machine. When set,
# these win over S3_PUBLIC_HOST / S3_PORT.
# S3_ENDPOINT=https://s3.eu-west-2.amazonaws.com
# S3_PUBLIC_URL=https://my-bucket.s3.eu-west-2.amazonaws.com
