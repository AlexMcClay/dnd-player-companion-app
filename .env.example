# Copy to .env and adjust. Docker Compose defaults match these values.

DATABASE_URL=postgresql://codex:codex@localhost:5432/codex

PORT=3001

# Passphrase that unlocks DM mode in the UI. Change this.
DM_KEY=marrowcoast

# MinIO locally; swap for real S3 / R2 / B2 credentials when hosting.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assets
S3_ACCESS_KEY=codexminio
S3_SECRET_KEY=codexminio123
# Base URL the browser uses to load images. Bucket is public-read locally.
S3_PUBLIC_URL=http://localhost:9000/assets
